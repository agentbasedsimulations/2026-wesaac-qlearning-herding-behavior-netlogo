<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[extensions [table]

globals [ 
  alfa 
  desconto 
  epsilon
  qtable 
  episode     
  
  success-count
  total-reward
  episode-reward
  episode-steps
  avg-reward
  avg-steps
  block-steps-accumulator
  plot-trigger-average
  plot-x-value
  recent-rewards
  recent-steps
]

breed [ cachorros cachorro ]
breed [ ovelhas ovelha ]

cachorros-own [ 
  ultimo-patch
]

patches-own [
  curral? 
  parede? 
  porteira?
]

to setup 
  clear-all
  
  set qtable table:make
  set alfa 0.4
  set desconto 0.8
  set epsilon 0.7  
  
  set episode 0
  set success-count 0
  set total-reward 0
  set episode-reward 0
  set episode-steps 0
  set avg-reward 0
  set avg-steps 0
  set block-steps-accumulator 0
  set plot-trigger-average 0
  set plot-x-value 0
  set recent-rewards []
  set recent-steps []
  
  setup-patches
  setup-turtles
  reset-ticks
end

to setup-patches
  ask patches [ 
    set pcolor green - random 3 
    set curral? false
    set parede? false
    set porteira? false
  ]
  setup-curral
end

to setup-curral
  let base-x 0
  let base-y 0
  let largura 4
  let altura 3
  
  ask patches with [
    pxcor > base-x and pxcor <= base-x + largura and
    pycor > base-y and pycor <= base-y + altura
  ] [
    set curral? true
    set pcolor green + random 2
  ]
  
  ask patches with [
    pxcor >= base-x and pxcor <= base-x + largura + 1 and
    pycor >= base-y and pycor <= base-y + altura + 1 and
    not curral?
  ] [
    set parede? true
    set pcolor brown - random 2
  ]
  
  ask patches with [ (pycor = 4) and (pxcor = 2 or pxcor = 3)] [
    set parede? false
    set porteira? true
    set curral? true
    set pcolor yellow
  ]
end

to setup-turtles
  create-ovelhas 5 [
    move-to one-of patches with [not curral? and not parede? and not any? turtles-on self]
    set color white
    set shape "sheep"
  ]
  
  create-cachorros 1 [
    move-to one-of patches with [not curral? and not parede? and not any? turtles-on self]
    set shape "wolf"
    set ultimo-patch patch-here
  ]
end

to go
  if ticks = 700000 [ stop ]
  
  ask ovelhas [ action-sheep ]
  ask cachorros [ action-dog ] 
  
  if all? ovelhas [curral?] [ 
    reset-ovelhas 
  ] 
  
  tick
end

to reset-ovelhas
  set total-reward total-reward + episode-reward
  set episode episode + 1
  
  set recent-rewards lput episode-reward recent-rewards
  set recent-steps lput episode-steps recent-steps
  
  if length recent-rewards > 1000 [
    set recent-rewards but-first recent-rewards
  ]
  
  if length recent-steps > 1000 [
    set recent-steps but-first recent-steps
  ]
  
  set avg-reward mean recent-rewards
  set avg-steps mean recent-steps
  set block-steps-accumulator block-steps-accumulator + episode-steps
  
  ask ovelhas [
    move-to one-of patches with [not curral? and not parede? and not any? turtles-on self]
  ]

  if aprendizado [
    set epsilon max (list 0.05 (epsilon * 0.99994))
  ]
  
  if episode mod 1 = 0 [
    set plot-trigger-average (block-steps-accumulator / 1)
    set plot-x-value episode
    
    set-current-plot "Tempo por episódio"
    plotxy plot-x-value plot-trigger-average
    
    set block-steps-accumulator 0
  ]
  
  set episode-reward 0
  set episode-steps 0
end

to action-sheep
  if curral? [
    let p one-of neighbors with [curral? and not parede? and not any? turtles-on self]
    if p != nobody [ move-to p ]
    stop
  ]

  if any? cachorros in-radius 2 [
    let closest-dog min-one-of cachorros [distance myself]
    let p max-one-of neighbors with [not parede? and not any? turtles-on self] [distance closest-dog]
    if p != nobody [ move-to p ]
    stop
  ]
  
  rt random 20 - 20 
  let alvo patch-ahead 1
  
  if alvo != nobody [
    ifelse not [parede?] of alvo and not [curral?] of alvo [
      if not any? turtles-on alvo [
        fd 0.5
      ]
    ] [
      rt 135 + random 90
    ]
  ]
end

to action-dog
  let sheep min-one-of ovelhas with [not curral?] [distance myself]
  if sheep = nobody [ stop ]
  run-q-learning sheep
end

to run-q-learning [sheep]
  let s get-state sheep
  let a choose-action s
  
  let old-dist-sheep-gate 0
  let old-pos patch-here
  let penultimo-pos ultimo-patch
  
  set old-dist-sheep-gate distance-sheep-to-gate sheep
  
  execute-primitive-action a sheep
  
  if patch-here != old-pos [
    set episode-steps episode-steps + 1
  ]
  
  let new-state get-state sheep
  let new-dist-dog-sheep distance sheep
  let new-dist-sheep-gate distance-sheep-to-gate sheep
  let new-pos patch-here
  
  let r get-reward sheep new-dist-dog-sheep old-dist-sheep-gate new-dist-sheep-gate old-pos new-pos penultimo-pos
  
  set episode-reward episode-reward + r
  
  if aprendizado [
    let terminal? [curral?] of sheep 
    update-q qtable s a r new-state terminal?
  ]
  
  set ultimo-patch old-pos
end

to execute-primitive-action [a sheep] 
  if a = 1 [ rt 45 ]   
  if a = 2 [ lt 45 ] 
  if a = 3 [ rt 180 ] 

  let target patch-ahead 1
  if target != nobody and not [parede?] of target and not any? turtles-on target [
    if not [curral?] of target [
      fd 1
    ]
  ]
end

to update-q [qtab s a r s2 terminal?]
  if not table:has-key? qtab s [ table:put qtab s (list 0 0 0 0) ]
  if not table:has-key? qtab s2 [ table:put qtab s2 (list 0 0 0 0) ]

  let q-values table:get qtab s
  let old-q item a q-values
  
  let max-next 0
  if not terminal? [
    set max-next max table:get qtab s2
  ]

  let new-q old-q + alfa * (r + desconto * max-next - old-q)
  table:put qtab s replace-item a q-values new-q
end

to-report choose-action [s]
  if not table:has-key? qtable s [
    table:put qtable s (list 0 0 0 0)
  ]
  
  let q-values table:get qtable s
  
  if aprendizado and random-float 1 < epsilon [ 
    report random 4 
  ]
  
  let max-q max q-values
  let candidates filter [i -> item i q-values = max-q] (list 0 1 2 3)
  
  report one-of candidates
end

to-report get-state [sheep]
  let ang-to-sheep subtract-headings (towards sheep) heading
  let angle-state floor ((ang-to-sheep + 180) / 45) mod 8

  let d distance sheep
  let dist-state 0
  if d >= 3 [
    set dist-state 1
  ]

  let gate one-of patches with [porteira?]
  let align-state 0  
  
  if gate != nobody [
    let sheep-to-gate [towards gate] of sheep
    let sheep-to-dog [towards myself] of sheep
    let diff subtract-headings sheep-to-dog sheep-to-gate
    
    if diff >= -30 and diff <= 30 [ set align-state 0 ]
    if diff > 30 and diff <= 120 [ set align-state 1 ]
    if diff < -30 and diff >= -120 [ set align-state 2 ]
    if diff > 120 or diff < -120 [ set align-state 3 ]
  ]
  
  report (list angle-state dist-state align-state)
end

to-report get-reward [sheep new-d-dog old-d-gate new-d-gate old-p new-p penultimo-p]
  let r -0.05
  set r r - (episode-steps * 0.0005)

  if [curral?] of sheep [
    set success-count success-count + 1
    report max (list 20 (150 - episode-steps * 0.3))
  ]

  if new-p = old-p [ set r r - 1 ]
  if new-p = penultimo-p [ set r r - 1 ]

  let delta-gate old-d-gate - new-d-gate
  set r r + (delta-gate * 15)

  let gate one-of patches with [porteira?]

  if gate != nobody [
    let sheep-to-gate [towards gate] of sheep
    let sheep-to-dog [towards myself] of sheep
    let diff abs(subtract-headings sheep-to-dog sheep-to-gate)

    let erro abs(180 - diff)
    set r r + (2.5 - (erro / 72))

    if diff > 40 and diff < 100 [ 
      set r r + 1.5 
    ]
    
    if diff > 150 [ set r r - 1.5 ]
  ]

  if new-d-dog < 1 [ set r r - 1 ]
  if new-d-dog > 7 [ set r r - 0.5 ]
  if any? patches in-radius 1 with [parede?] [
    set r r - 0.2
  ]

  report r
end

to-report distance-sheep-to-gate [sheep]
  let gate one-of patches with [porteira?]
  if gate = nobody [ report 0 ]
  report [distance gate] of sheep
end

to Q-table
  foreach table:keys qtable [
    k ->
    print (word "State: " k " | Q-Values: " table:get qtable k)
  ]
end]]></code>
  <widgets>
    <view x="275" wrappingAllowedX="true" y="5" frameRate="30.0" minPycor="0" height="334" showTickCounter="true" patchSize="30.05" fontSize="10" wrappingAllowedY="true" width="184" tickCounterLabel="ticks" maxPycor="10" updateMode="1" maxPxcor="5" minPxcor="0"></view>
    <plot x="475" autoPlotX="true" yMax="10.0" autoPlotY="true" y="10" xMin="0.0" height="330" legend="true" xMax="10.0" yMin="0.0" width="430" display="Métricas">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="reward" color="-8732573" legend="true">
        <setup></setup>
        <update>plotxy episode avg-reward</update>
      </pen>
      <pen interval="1.0" mode="0" display="steps" color="-11033397" legend="true">
        <setup></setup>
        <update>plotxy episode avg-steps</update>
      </pen>
    </plot>
    <monitor x="145" precision="17" y="105" height="60" fontSize="11" width="115" display="Episódios">episode</monitor>
    <monitor x="145" precision="17" y="235" height="60" fontSize="11" width="115" display="Epsilon">epsilon</monitor>
    <monitor x="145" precision="17" y="170" height="60" fontSize="11" width="115" display="Alfa">alfa</monitor>
    <button x="145" y="60" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55" display="Ir">go</button>
    <button x="205" y="60" height="40" disableUntilTicks="true" forever="true" kind="Observer" width="55" display="Ir">go</button>
    <button x="145" y="15" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="115" display="Iniciar">setup</button>
    <plot x="910" autoPlotX="true" yMax="10.0" autoPlotY="true" y="10" xMin="0.0" height="330" legend="true" xMax="10.0" yMin="0.0" width="715" display="Episódios">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Episódios" color="-14350824" legend="true">
        <setup></setup>
        <update>plot episode</update>
      </pen>
    </plot>
    <switch x="145" y="300" height="40" on="true" variable="Aprendizado" width="115" display="Aprendizado"></switch>
    <note x="475" y="375" backgroundDark="-12895429" fontSize="16" width="1150" markdown="false" height="30" textColorDark="-1" textColorLight="-16777216" backgroundLight="-4013374">Gráfico apenas de visualização, básicamente é os steps mas a cada episódio e não a média dos últimos mil.</note>
    <plot x="475" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Média de tempo dos episódios " y="410" xMin="0.0" height="360" legend="false" xMax="10.0" yMin="0.0" width="1150" xAxis="Episódios " display="Tempo por episódio">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-2674135" legend="true">
        <setup></setup>
        <update>plotxy plot-x-value plot-trigger-average</update>
      </pen>
    </plot>
  </widgets>
  <info><![CDATA[## WHAT IS IT?

A Q-Learning experiment where one dog learns to herd multiple sheep through a gate. The dog and sheep spawn in random positions at the start of each episode, and the sheep move away when the dog gets too close. The dog has no pre-programmed herding rules—it learns entirely from trial and error using a Q-table.

## HOW IT WORKS

The dog sees the world through three simple geometric checks relative to the closest sheep:
Distance to sheep: near or far
Angle to sheep: 8 directional sectors
Alignment with gate: is the dog behind the sheep, to the side, or in front?

Based on this state, the dog picks one of five actions: move forward, turn left, turn right, orbit around the sheep, or move tangent to adjust position.
The sheep move randomly when the dog is far away, and flee directly away when the dog enters their perception zone. At the start of every episode, the dog and all sheep are placed in random positions outside the corral.

Rewards guide the learning:
+10 when a sheep enters the gate
+4 when the sheep gets closer to the gate
-0.5 when the sheep moves away or the dog gets too far
-0.1 every step (time penalty)
-1 if the dog gets stuck repeating positions
The dog updates its Q-table after every action using the Bellman equation.

## HOW TO USE IT

Buttons
Setup: Places dog and sheep in random starting positions outside the corral. Clears plots.
Go: Starts training. The dog runs episodes automatically, resetting each time a sheep enters the gate.
Go Once: Runs a single step.
Run Episode: Runs one complete episode using the current learned policy (no new learning).

Plots
Completed Episodes: Total successes over time.
Avarege steps: Avarege steps collected in the last one thousand completed episodes.
Avarege reward: Avarege reward collected in the last one thousand completed episodes.

## THINGS TO NOTICE

The dog takes longer to converge because every episode starts differently and the sheep move on their own. The Steps and Reward plots will be noisier and take more episodes to stabilize.
Once trained, the dog adapts its path to each random starting configuration rather than repeating a single fixed route.
The Completed Episodes plot trends upward but may not be a perfectly straight line due to varying initial distances and sheep behavior.

## RELATED MODELS

Q-Learning Maze (NetLogo Library): Simpler grid-world Q-learning example.
Shepherds (NetLogo Library): Manual herding model for comparison.
Flocking (NetLogo Library): For multi-agent movement behaviors.

## CREDITS AND REFERENCES

Based on: Applying Q-Learning to Herding Behavior: A Single-Agent Approach in NetLogo (2026).
Watkins & Dayan (1992). Q-learning. Machine Learning.
Strömbom et al. (2014). Solving the shepherding problem. Proceedings of the Royal Society B.
Lien et al. (2004). Shepherding behaviors with multiple shepherds. IEEE ICRA.]]></info>
