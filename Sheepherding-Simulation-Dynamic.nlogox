      <setup>setup</setup>
      <go>go</go>
      <runMetricsCondition>ticks = 100000</runMetricsCondition>
      <metrics>
        <metric>episode</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="alfa" first="0.01" step="0.01" last="0.09"></steppedValueSet>
        <steppedValueSet variable="epsilon" first="0.1" step="0.1" last="0.9"></steppedValueSet>
        <steppedValueSet variable="desconto" first="0.7" step="0.05" last="1"></steppedValueSet>
      </constants>
    </experiment>
  </experiments>
